{
  "name": "todoist-focus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal Todoist dashboard with rule-based Today's Focus.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --open /?mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
